# =============================================================================
# PortFlow AI — Root Environment Configuration Template (.env.example)
# =============================================================================

# ── App & Service Configuration ───────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
# DEMO_MODE=false connects to external LLM if any API key is provided
DEMO_MODE=false

# ── Supabase Cloud Database ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
# Optional direct Postgres:
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DB_PATH=portflow.db

# ── LLM Copilot Providers (Provide at least one) ──────────────────────────────
# 1. Groq (Free fast LLM at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 2. OpenRouter (Free models at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. Google Gemini (Free tier at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. IBM watsonx.ai
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Frontend Configuration ─────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
