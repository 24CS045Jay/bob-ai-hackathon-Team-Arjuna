# ── App Configuration ──────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
DEMO_MODE=true          # true = use grounded template copilot; false = use watsonx.ai

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=./portflow.db   # SQLite database path relative to backend

# ── watsonx.ai (Optional, active only when DEMO_MODE=false) ────────────────────
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Frontend Configuration ─────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
