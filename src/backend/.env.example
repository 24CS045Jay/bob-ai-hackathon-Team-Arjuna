# =============================================================================
# PortFlow AI — Backend Environment Template (.env.example)
# =============================================================================

# ── Supabase Cloud Database Configuration ─────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key

# Optional direct PostgreSQL connection (requires your Supabase DB password):
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Local SQLite fallback path (used when DATABASE_URL is not set)
DB_PATH=portflow.db

# ── AI Copilot LLM Configuration ──────────────────────────────────────────────
# DEMO_MODE=true uses our deterministic grounded engine (zero external API calls required)
# DEMO_MODE=false uses the configured LLM API with live terminal context grounding
DEMO_MODE=false

# Free LLM API Keys (Supports any one of the following):
# 1. Groq (Free, ultra-fast Llama-3.3-70B at https://console.groq.com)
GROQ_API_KEY=

# 2. OpenRouter (Free models at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 3. Google Gemini (Free tier at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 4. IBM watsonx.ai (Enterprise Granite Foundation Models)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
